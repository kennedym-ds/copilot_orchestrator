{
	"_comment": "VS Code Copilot MCP config — full server set. Claude Code sessions use .mcp.json at the repo root, which omits githubLocal and translation because those require the .venv interpreter path that only VS Code resolves via ${workspaceFolder}.",
	"servers": {
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/"
		},
		"context7": {
			"type": "http",
			"url": "https://mcp.context7.com/mcp",
			"headers": {
				"CONTEXT7-API-KEY": "${input:context7ApiKey}"
			}
		},
		"githubLocal": {
			"type": "stdio",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"${workspaceFolder}/scripts/mcp/github_server.py"
			]
		},
		"research": {
			"type": "stdio",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"${workspaceFolder}/scripts/mcp/research_server.py"
			]
		},
		"translation": {
			"type": "stdio",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"${workspaceFolder}/scripts/mcp/translation_server.py"
			]
		},
		"validation": {
			"type": "stdio",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"${workspaceFolder}/scripts/mcp/validation_server.py"
			],
			"dev": {
				"watch": "scripts/mcp/validation_server.py"
			}
		}
	}
}
