{
	"servers": {
		"github": {
			"type": "http",
			"url": "https://api.githubcopilot.com/mcp/"
		},
		"githubLocal": {
			"type": "stdio",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"${workspaceFolder}/scripts/mcp/github_server.py"
			]
		},
		"research": {
			"type": "stdio",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"${workspaceFolder}/scripts/mcp/research_server.py"
			]
		},
		"translation": {
			"type": "stdio",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"${workspaceFolder}/scripts/mcp/translation_server.py"
			]
		},
		"validation": {
			"type": "stdio",
			"command": "${workspaceFolder}/.venv/Scripts/python.exe",
			"args": [
				"${workspaceFolder}/scripts/mcp/validation_server.py"
			],
			"dev": {
				"watch": "scripts/mcp/validation_server.py"
			}
		}
	}
}