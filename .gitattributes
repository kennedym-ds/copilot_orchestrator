# Auto-detect text files and normalize line endings to LF
* text=auto eol=lf

# Explicitly mark as text
*.md text
*.yml text
*.yaml text
*.json text
*.ps1 text
*.psm1 text
*.psd1 text
*.py text
*.js text
*.ts text
*.css text
*.html text
*.sh text eol=lf

# Denote binary files
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.pdf binary
*.zip binary
